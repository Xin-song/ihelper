generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 3 前恒等于「我一个人」，见 docs/ARCHITECTURE.md 第 4 节
model Space {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members        SpaceMember[]
  ingredients    Ingredient[]
  recipes        Recipe[]
  stockItems     StockItem[]
  tasks          Task[]
  taskTopics     TaskTopic[]
  calendarEvents CalendarEvent[]

  @@map("spaces")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 登录用户名，见 ARCHITECTURE.md 4.4 —— 自托管场景不做公开注册，邮箱非必填
  username     String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  /// 昵称，展示用
  displayName  String    @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  bio          String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  memberships     SpaceMember[]
  submissions     RecipeSubmission[]
  authoredRecipes Recipe[]           @relation("RecipeAuthor")
  tasks           Task[]
  taskTopics      TaskTopic[]
  calendarEvents  CalendarEvent[]

  @@map("users")
}

/// Phase 1 只会有一行，表结构现在就建好，见 docs/ARCHITECTURE.md 4.2
model SpaceMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// owner / member / readonly，应用层校验，见 packages/shared
  role      String   @default("owner")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_members")
}

/// 食材主数据，REQUIREMENTS.md 1.1
model Ingredient {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId      String    @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  name         String
  /// 别名数组，如「土豆/马铃薯/洋芋」指向同一条，支持模糊匹配搜索
  aliases      String[]  @default([])
  /// vegetable / meat_poultry / seafood / condiment / staple / dry_goods / other
  category     String
  defaultUnit  String    @map("default_unit")
  note         String?
  /// 合并到哪条食材（软删除 + 保留审计轨迹），见 REQUIREMENTS.md 1.1
  mergedIntoId String?   @map("merged_into_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  space             Space              @relation(fields: [spaceId], references: [id])
  mergedInto        Ingredient?        @relation("IngredientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom        Ingredient[]       @relation("IngredientMerge")
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

/// 菜谱，REQUIREMENTS.md 1.3
model Recipe {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId        String    @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  title          String
  coverImageUrl  String?   @map("cover_image_url")
  description    String?
  category       String?
  /// 标签数组，自由创建，见 ARCHITECTURE.md 关于数组列的说明
  tags           String[]  @default([])
  /// 步骤：有序数组，每项 { stepNumber, body, imageUrl?, timerSeconds? }
  /// 用 JSONB 而非独立表，理由见 docs/DATABASE.md
  steps          Json      @default("[]")
  prepMinutes    Int?      @map("prep_minutes")
  cookMinutes    Int?      @map("cook_minutes")
  /// 1-5，CHECK 约束见迁移 SQL
  difficulty     Int?
  /// 基准份数，允许半份（如 2.5 人份），CHECK > 0 见迁移 SQL
  servings       Decimal   @db.Decimal(5, 1)
  /// 来源：链接 / 书名 / 「奶奶教的」
  source         String?
  /// private：只在「我的菜谱」可见；public：同时出现在菜谱广场
  /// Phase 3 有多用户前，广场里只会是自己的菜谱，但模型现在就按最终形态建
  visibility     String    @default("private")
  personalRating Int?      @map("personal_rating")
  lastCookedAt   DateTime? @map("last_cooked_at") @db.Timestamptz
  /// 全文检索用，GENERATED ALWAYS AS 表达式在迁移 SQL 里补，Prisma 只知道类型
  searchVector   Unsupported("tsvector")? @map("search_vector")
  /// 作者，登录用户接入前建的菜谱这里是 null（见 ARCHITECTURE.md 4.4 的兼容说明）
  authorId       String?   @map("author_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  space             Space              @relation(fields: [spaceId], references: [id])
  author             User?              @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  submissions       RecipeSubmission[]
  printImages       RecipePrintImage[]

  @@map("recipes")
}

/// 「作业」：跟着某个菜谱做出来的成品，一条带图的帖子
/// 挂在菜谱下（recipeId 必填），菜谱详情页和作业广场都读这张表
model RecipeSubmission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId  String @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  /// Phase 3 接入真实用户后回填；在那之前靠 authorName 展示
  userId   String? @map("user_id") @db.Uuid
  /// 冗余的展示名，避免为了列个作业流去 join users
  authorName String @default("我") @map("author_name")
  /// 成品图，至少一张，顺序即展示顺序
  images     String[] @default([])
  /// 心得 / 经验 / 踩坑记录
  body       String
  /// 做完给这道菜打的分，1-5，CHECK 约束见迁移 SQL
  rating     Int?
  /// 互动计数，先做最简单的点赞
  likeCount  Int      @default(0) @map("like_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 索引是手写的局部索引（WHERE deleted_at IS NULL + DESC），Prisma DSL 表达不了，见迁移 SQL
  @@map("recipe_submissions")
}

/// 用户上传的「打印版」菜谱图：整张排好版的菜谱，横版或竖版
/// 和 coverImageUrl 是两回事——封面是列表缩略图，这个是拿去打印的成品
model RecipePrintImage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  url      String
  /// landscape（横版）/ portrait（竖版）
  /// 枚举值按 ARCHITECTURE.md 4.3 交给应用层校验，不加 CHECK
  orientation String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_print_images")
}

/// 菜谱的配料表条目，REQUIREMENTS.md 1.2 / 1.3
model RecipeIngredient {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId     String   @map("recipe_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  /// exact：精确用量，走 quantity + unit；vague：模糊用量，走 vagueLabel
  amountType   String   @default("exact") @map("amount_type")
  quantity     Decimal? @db.Decimal(10, 3)
  unit         String?
  /// 适量 / 少许 / 按口味，缩放时原样保留
  vagueLabel   String?  @map("vague_label")
  /// 「切丁」「提前泡发」之类的备注
  note         String?
  isOptional   Boolean  @default(false) @map("is_optional")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@map("recipe_ingredients")
}

/// 库存物品，REQUIREMENTS.md 2.1（Phase 2 提前做的最小版：分类 + 数量 + 安全库存）
model StockItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId     String    @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  name        String
  /// 复用食材分类，见 packages/shared 的 INGREDIENT_CATEGORIES
  category    String
  /// CHECK (quantity >= 0) 在迁移 SQL 里补
  quantity    Decimal   @default(0) @db.Decimal(10, 3)
  unit        String
  /// 安全库存，低于这个值就进采购清单；为空表示不设阈值、不提醒。CHECK (safety_stock >= 0) 在迁移 SQL 里补
  safetyStock Decimal?  @map("safety_stock") @db.Decimal(10, 3)
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  space Space @relation(fields: [spaceId], references: [id])

  @@map("stock_items")
}

/// 待办，REQUIREMENTS.md 3.1（子任务=主题下的待办事项本身，不做更深一层嵌套；见 docs/DATABASE.md）
model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId     String    @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  /// 待办是私人数据，按 userId 过滤，不像 Recipe 那样对全 space 可见
  userId      String    @map("user_id") @db.Uuid
  /// 所属主题（待办事项主题看板的「文件夹」），为空表示未分组，见 TaskTopic
  topicId     String?   @map("topic_id") @db.Uuid
  title       String
  /// 详情/备注，主题看板 UI 里叫「详情备注」
  description String?
  /// 截止时间，为空表示无截止日期的待办
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  /// low / medium / high，应用层校验，见 packages/shared
  priority    String    @default("medium")
  /// todo / in_progress / done / cancelled
  status      String    @default("todo")
  tags        String[]  @default([])
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  /// 归档标记，归档后不在主题看板总览视图展示，只在 Archived 视图可见
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz
  /// 放入「今日日程管理」时间轴上的起止时间，两者同时为空表示未放入时间轴
  scheduledStartAt DateTime? @map("scheduled_start_at") @db.Timestamptz
  scheduledEndAt   DateTime? @map("scheduled_end_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  space Space      @relation(fields: [spaceId], references: [id])
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic TaskTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

/// 待办事项主题（主题看板的「文件夹」），REQUIREMENTS.md 3.1「所属项目/清单」的落地
model TaskTopic {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId   String    @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  /// 私人数据，按 userId 过滤，同 Task
  userId    String    @map("user_id") @db.Uuid
  name      String
  /// 看板展示用的强调色，可选
  color     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  space Space  @relation(fields: [spaceId], references: [id])
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("task_topics")
}

/// 纯日程事件（有起止时间、无完成状态），REQUIREMENTS.md 3.2
model CalendarEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId     String    @default("00000000-0000-0000-0000-000000000001") @map("space_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  location    String?
  startAt     DateTime  @map("start_at") @db.Timestamptz
  endAt       DateTime  @map("end_at") @db.Timestamptz
  /// CHECK (end_at >= start_at) 在迁移 SQL 里补
  allDay      Boolean   @default(false) @map("all_day")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  space Space @relation(fields: [spaceId], references: [id])
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}
