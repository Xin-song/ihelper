# PostgreSQL（docker-compose 与 apps/api 共用）
POSTGRES_USER=ihelper
POSTGRES_PASSWORD=ihelper
POSTGRES_DB=ihelper
POSTGRES_PORT=5432

# apps/api 用的完整连接串（Prisma）
DATABASE_URL="postgresql://ihelper:ihelper@localhost:5432/ihelper?schema=public"

# 登录 JWT 签名密钥。必填，缺失时 API 启动会直接报错退出。生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
